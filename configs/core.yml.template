server:
    address: 0.0.0.0:GRPC_PORT
    http: {enabled: false, address: 0.0.0.0:HTTP_PORT}
    authentication: {token-expiration-seconds: 5000}
    encryption: {enabled: false}
storage:
    data-directory: DATA_DIR_PLACEHOLDER
logging:
    directory: LOG_DIR_PLACEHOLDER
diagnostics:
    monitoring: {enabled: false, port: MONITORING_PORT}
    reporting: {metrics: false, errors: false}
